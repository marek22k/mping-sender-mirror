# AppArmor policy for mping-sender

include <tunables/global>

/usr/bin/mping-sender flags=(enforce) {
  include <abstractions/base>

  capability setpcap,

  network (create) inet dgram,
  network (create) inet6 dgram,
  network (bind) inet dgram,
  network (bind) inet6 dgram,
  network (getattr) inet dgram,
  network (getattr) inet6 dgram,
  network (setattr) inet dgram,
  network (setattr) inet6 dgram,
  network (getopt) inet dgram,
  network (getopt) inet6 dgram,
  network (setopt) inet dgram,
  network (setopt) inet6 dgram,
  network (receive) inet dgram,
  network (receive) inet6 dgram,
  network (send) inet dgram,
  network (send) inet6 dgram,
}

# vim:syntax=apparmor

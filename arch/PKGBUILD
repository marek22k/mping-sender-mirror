pkgname=mping-sender
pkgver=v1.0.0
pkgrel=1
pkgdesc="a network simulation program"
arch=('x86_64')
url="https://codeberg.org/mark22k/mping-sender"
license=('GPL-3.0-or-later')
depends=('boost' 'libcap-ng' 'libseccomp')
makedepends=('meson' 'gtest')
source=("https://codeberg.org/mark22k/mping-sender/archive/v$pkgver.tar.gz")
sha512sums=('XXX')

build() {
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
}
